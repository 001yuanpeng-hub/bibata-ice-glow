root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
charset = utf-8-bom
indent_size = 4

[*.cs]
charset = utf-8
indent_size = 4

[*.{yml,yaml,json,xml,manifest}]
charset = utf-8
indent_size = 2

[*.md]
trim_trailing_whitespace = false
